# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# Tool Mode: mock, live, hybrid
TOOL_MODE=mock

# Database (PostgreSQL)
POSTGRES_USER=fintech_user
POSTGRES_PASSWORD=fintech_secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fintech_support
DATABASE_URL=postgresql+asyncpg://fintech_user:fintech_secret@localhost:5432/fintech_support
SYNC_DATABASE_URL=postgresql://fintech_user:fintech_secret@localhost:5432/fintech_support

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# LLM Providers (for FEAT-001)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Live Tool Providers (for production / hybrid mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
CORE_BANKING_API_URL=
CORE_BANKING_API_KEY=
FRESHDESK_DOMAIN=
FRESHDESK_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
